if SHIELD_LILY58_DONGLE

config ZMK_KEYBOARD_NAME
    default "Lily58"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Both halves are peripherals now; neither talks to the other.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# 2 peripherals + the 5 default BLE profiles.
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
